# 复制为 .env 后使用：cp backend/.env.example backend/.env
# .env 已在 .gitignore 中，不会被提交

# —— 数据库 ——
# 格式：postgresql+asyncpg://用户:密码@主机:端口/库名
DATABASE_URL=postgresql+asyncpg://ielts:ielts_dev_pw@localhost:5432/ielts_vocab

# Alembic 用同步驱动（迁移不需要 async）
DATABASE_URL_SYNC=postgresql+psycopg2://ielts:ielts_dev_pw@localhost:5432/ielts_vocab

# —— JWT ——
# 生产环境务必换掉：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# —— CORS ——
CORS_ORIGINS=http://localhost:5173

# —— 音频 ——
AUDIO_DIR=static/audio
